{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin", "/admin.html",
      "/parent", "/parent.html",
      "/child", "/child.html",
      "/game", "/game.html"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hh", "database_id": "f501cdb3-5559-4ff7-960c-97775238fe4d", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "hh.oliv.cz", "custom_domain": true }],
  // Noční přepočet historie. 22:10 a 23:10 UTC: jedno z toho vychází těsně po půlnoci v Praze v létě i v zimě.
  "triggers": { "crons": ["10 22 * * *", "10 23 * * *"] },
  "observability": { "enabled": true }
}
