{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin", "/admin.html",
      "/parent", "/parent.html",
      "/child", "/child.html"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hh", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "hh.oliv.cz", "custom_domain": true }],
  "observability": { "enabled": true }
}
