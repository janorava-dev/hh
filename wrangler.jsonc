{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "hh.oliv.cz", "custom_domain": true }],
  "observability": { "enabled": true }
}
